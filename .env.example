# Supabase Public Configuration (Browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secrets (NEVER expose to browser / NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Authorized Studio Owner Email (Single Owner Access)
ADMIN_OWNER_EMAIL=owner@nalakara.com

# Development-only UI inspection bypass. Must never be enabled in production.
ADMIN_DEV_BYPASS=false
